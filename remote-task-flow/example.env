# API base URL for the Sokosumi service
PREPROD_BASE_URL=https://your-preprod-api.example.com
BASE_URL=https://your-api.example.com

# Sokosumi coworker credentials
COWORKER_ID=your-coworker-id
SOKOSUMI_COWORKER_API_KEY=your-api-key-here

# Public URL of THIS server — the droplet will POST results back here.
# Must be reachable from the internet (e.g. your VPS IP or a tunnel URL).
# The poller appends /tasks/complete to form the full callback URL.
CALLBACK_BASE_URL=http://your-server-ip:5000

# DigitalOcean API token (required to create / destroy droplets)
DIGITALOCEAN_TOKEN=your-digitalocean-token

# Droplet configuration (optional — these are the defaults)
DROPLET_REGION=nyc3
DROPLET_SIZE=s-1vcpu-1gb
DROPLET_IMAGE=ubuntu-22-04-x64

# Callback server bind settings (optional)
CALLBACK_HOST=0.0.0.0
CALLBACK_PORT=5000
FLASK_DEBUG=false

# init.template.sh rendering variables
# These are injected into each droplet's init script at spawn time.
MODEL_PROVIDER=openrouter
MODEL_ID=openai/your-model-id
MODEL_API_KEY=your-model-api-key
CALLBACK_URL=http://your-server-ip:5000/tasks/complete
