# Prod key
#SOKO_API_KEY=your-prod-api-key

# Preprod key
SOKO_API_KEY=your-preprod-api-key

# API base URL for the Sokosumi preprod service
PREPROD_BASE_URL=https://api.preprod.sokosumi.com/v1

# Sokosumi coworker credentials
COWORKER_ID=your-coworker-id
SOKOSUMI_COWORKER_API_KEY=your-coworker-api-key

# Optional: override the default pi model
PI_MODEL=openrouter/openai/gpt-4o-mini

# DigitalOcean API token (required to create / destroy droplets)
DIGITALOCEAN_TOKEN=your-digitalocean-token

# Droplet configuration
DROPLET_REGION=fra1
DROPLET_SIZE=s-1vcpu-1gb
DROPLET_IMAGE=your-droplet-image-id
DROPLET_SSH_KEY_ID=your-ssh-key-id
# DROPLET_PROJECT_ID=your-project-id  # requires project:update token scope

# init.template.sh rendering variables
# These are injected into each droplet's init script at spawn time.
MODEL_PROVIDER=openrouter
MODEL_ID=openai/gpt-4o
MODEL_API_KEY=your-model-api-key
CALLBACK_URL=http://your-server-ip/tasks/complete

# Callback server bind settings
# Nginx on this host proxies :80 → localhost:5000
CALLBACK_HOST=0.0.0.0
CALLBACK_PORT=5000
