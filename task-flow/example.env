# Prod key
#SOKO_API_KEY=your-prod-api-key

# Preprod key
SOKO_API_KEY=your-preprod-api-key

# API base URL for the Sokosumi preprod service
PREPROD_BASE_URL=https://api.preprod.sokosumi.com/v1

# Sokosumi coworker credentials
COWORKER_ID=your-coworker-id
SOKOSUMI_COWORKER_API_KEY=your-coworker-api-key

# Optional: override the default pi model
PI_MODEL=openrouter/openai/gpt-4o-mini
